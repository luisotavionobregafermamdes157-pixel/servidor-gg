# Copia para api/.env. NUNCA publiques o ficheiro .env.
PORT=3000
NODE_ENV=production
FRONTEND_ORIGIN=https://luisotavionobregafermamdes157-pixel.github.io
JWT_SECRET=change-this-to-a-long-random-secret
DATABASE_PATH=./data/servidor-gg.sqlite

# URL do teu Pterodactyl Panel, sem barra no fim.
PTERODACTYL_URL=https://panel.example.com
# Application API key. Guardar APENAS no servidor backend.
PTERODACTYL_APPLICATION_KEY=ptla_replace_me
# ID do utilizador de serviço no Pterodactyl. Os servidores do MVP ficam associados
# a este utilizador; o backend controla a propriedade através da sua própria base de dados.
PTERODACTYL_OWNER_ID=1
PTERODACTYL_ALLOCATION_ID=1

# Limites máximos impostos pelo alojamento (MB / MB / percentagem CPU).
MAX_RAM_MB=4096
MAX_DISK_MB=10240
MAX_CPU_PERCENT=200
DEFAULT_RAM_MB=2048
DEFAULT_DISK_MB=5120
DEFAULT_CPU_PERCENT=100\nMAX_SERVERS_PER_USER=1

# Configuração por software. Os IDs e variáveis dependem dos Eggs instalados no teu painel.
# Adiciona uma entrada por egg real que tenhas instalado. Não inventes IDs.
# Exemplo estrutural (substitui valores e confirma as variáveis no teu Egg):
# EGG_MAP_JSON={"paper":{"nestId":1,"eggId":3,"dockerImage":"ghcr.io/pterodactyl/yolks:java_21","startup":"java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}","versionVariable":"MINECRAFT_VERSION","environment":{"SERVER_JARFILE":"server.jar","BUILD_TYPE":"default"}}}
EGG_MAP_JSON={}
